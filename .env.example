# ==========================================
# Sequel / Chronicle Backend Environment Configuration
# ==========================================

# Server Environment & Port Configuration
PORT=3000
NODE_ENV=development

# Gemini AI API Key (Required for AI search, synopsis generation, cover art, and book discovery)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# The Movie Database (TMDB) API Key (Required for Movie/TV search, cast/crew, details, and watchlist integration)
# Get a key from TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Firebase Admin SDK Credentials (Optional - for cloud user database & session sync)
# Generate a service account private key in Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_BOOKS_API_KEY: Optional API key for Google Books API
GOOGLE_BOOKS_API_KEY=

# NYT_API_KEY: Required for New York Times Books API.
NYT_API_KEY=

# NYT_API_SECRET is not required.
NYT_API_SECRET=

